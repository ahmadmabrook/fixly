generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuid_ossp(map: "uuid-ossp")]
}

// ─────────────────────────────────────────────
// Users & Auth
// ─────────────────────────────────────────────

model User {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  phone       String   @unique
  role        UserRole @default(CUSTOMER)
  name        String?
  avatarUrl   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  refreshTokens     RefreshToken[]
  deviceTokens      DeviceToken[]
  technicianProfile TechnicianProfile?
  customerBookings  Booking[]          @relation("CustomerBookings")
  notifications     Notification[]
  reviewsGiven      Review[]           @relation("ReviewsGiven")
  reviewsReceived   Review[]           @relation("ReviewsReceived")
  supportTickets    SupportTicket[]

  // Admin customer list filters by role.
  @@index([role])
  // Admin lists order by createdAt desc.
  @@index([createdAt])
  @@map("users")
}

enum UserRole {
  CUSTOMER
  TECHNICIAN
  ADMIN
}

model RefreshToken {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @db.Uuid
  // SHA-256 of the opaque token; the raw value is returned to the client only.
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model DeviceToken {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model AdminUser {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs     AdminAuditLog[]
  refreshTokens AdminRefreshToken[]

  @@map("admin_users")
}

model AdminRefreshToken {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  adminId   String   @db.Uuid
  // SHA-256 of the opaque token; the raw value goes out only via httpOnly cookie.
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_refresh_tokens")
}

/// Immutable trail of privileged admin actions (who did what, when, from where).
model AdminAuditLog {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  actorId    String   @db.Uuid
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor AdminUser @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

// ─────────────────────────────────────────────
// Services Catalog
// ─────────────────────────────────────────────

model Service {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nameAr      String
  nameEn      String
  category    String
  priceJod    Decimal  @db.Decimal(10, 3)
  durationMin Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings Booking[]

  // Public catalogue query: WHERE isActive ORDER BY category.
  @@index([isActive, category])
  @@map("services")
}

// ─────────────────────────────────────────────
// Technician Profile
// ─────────────────────────────────────────────

model TechnicianProfile {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId           String   @unique @db.Uuid
  bio              String?
  isAvailable      Boolean  @default(false)
  isVerified       Boolean  @default(false)
  currentLat       Float?
  currentLng       Float?
  locationUpdatedAt DateTime?
  rating           Decimal  @default(0) @db.Decimal(3, 2)
  totalReviews     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  techBookings    Booking[] @relation("TechnicianBookings")
  payouts         Payout[]

  // getStats counts verified technicians; admin list orders by createdAt.
  @@index([isVerified])
  @@index([createdAt])
  @@map("technician_profiles")
}

// ─────────────────────────────────────────────
// Bookings
// ─────────────────────────────────────────────

model Booking {
  id            String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerId    String        @db.Uuid
  technicianId  String?       @db.Uuid
  serviceId     String        @db.Uuid
  status        BookingStatus @default(PENDING)
  addressLine   String
  addressLat    Float
  addressLng    Float
  scheduledAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  totalJod      Decimal       @db.Decimal(10, 3)
  version       Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer     User               @relation("CustomerBookings", fields: [customerId], references: [id])
  technician   TechnicianProfile? @relation("TechnicianBookings", fields: [technicianId], references: [id])
  service      Service            @relation(fields: [serviceId], references: [id])
  payment      Payment?
  outboxEvents OutboxEvent[]
  reviews      Review[]
  guarantee    GuaranteeTicket?
  notifications Notification[]

  @@index([customerId])
  @@index([status])
  // Technician dashboard: "my active jobs" filters by technician + status.
  @@index([technicianId, status])
  @@map("bookings")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

// ─────────────────────────────────────────────
// Payments & Ledger
// ─────────────────────────────────────────────

model Payment {
  id                String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  bookingId         String        @unique @db.Uuid
  status            PaymentStatus @default(PENDING)
  provider          String
  providerRef       String?
  currency          String        @default("JOD")
  // Authorized (held) amount. Capture/refund amounts may be ≤ this (partial).
  amountJod         Decimal       @db.Decimal(10, 3)
  capturedAmountJod Decimal?      @db.Decimal(10, 3)
  // Cumulative amount refunded — supports multiple partial refunds.
  refundedAmountJod Decimal       @default(0) @db.Decimal(10, 3)
  // Platform commission withheld at capture (the rest accrues to the technician).
  feeJod            Decimal?      @db.Decimal(10, 3)
  preAuthorizedAt   DateTime?
  capturedAt        DateTime?
  refundedAt        DateTime?
  disputedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  booking       Booking        @relation(fields: [bookingId], references: [id])
  ledgerEntries LedgerEntry[]
  payout        Payout?
  disputes      Dispute[]

  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PRE_AUTHORIZED
  CAPTURED
  PARTIALLY_REFUNDED
  REFUNDED
  DISPUTED
  CHARGEBACK
  FAILED
}

model LedgerEntry {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  // Exactly one of paymentId / payoutId is set, depending on the entry type.
  paymentId   String?     @db.Uuid
  payoutId    String?     @db.Uuid
  type        LedgerType
  // Double-entry direction so SUM over a payment nets correctly
  // (CREDIT = money in to platform, DEBIT = money out). Nullable only for
  // pre-existing rows written before this column existed.
  direction   LedgerDirection?
  currency    String      @default("JOD")
  amountJod   Decimal     @db.Decimal(10, 3)
  description String?
  createdAt   DateTime    @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id])
  payout  Payout?  @relation(fields: [payoutId], references: [id])

  @@index([paymentId])
  @@index([payoutId])
  @@map("ledger_entries")
}

enum LedgerType {
  CHARGE
  CAPTURE
  REFUND
  PAYOUT
  FEE
  DISPUTE
  CHARGEBACK
  ADJUSTMENT
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

model Payout {
  id           String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  technicianId String       @db.Uuid
  // Source payment this payout was accrued from. Unique → at most one payout
  // per captured payment, making accrual idempotent.
  paymentId    String?      @unique @db.Uuid
  currency     String       @default("JOD")
  amountJod    Decimal      @db.Decimal(10, 3)
  status       PayoutStatus @default(PENDING)
  processedAt  DateTime?
  createdAt    DateTime     @default(now())

  technician    TechnicianProfile @relation(fields: [technicianId], references: [id])
  payment       Payment?          @relation(fields: [paymentId], references: [id])
  ledgerEntries LedgerEntry[]

  @@index([technicianId])
  // getStats counts PENDING; admin list filters status + orders by createdAt.
  @@index([status, createdAt])
  @@map("payouts")
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// A PSP-reported dispute / chargeback against a captured payment.
model Dispute {
  id          String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  paymentId   String        @db.Uuid
  providerRef String?
  reason      String?
  amountJod   Decimal       @db.Decimal(10, 3)
  status      DisputeStatus @default(OPEN)
  openedAt    DateTime      @default(now())
  resolvedAt  DateTime?

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("disputes")
}

enum DisputeStatus {
  OPEN
  WON
  LOST
}

/// Idempotent store of inbound PSP webhook events (dedupe at-least-once delivery).
model PspWebhookEvent {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  provider   String
  eventId    String
  eventType  String
  payload    Json
  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@map("psp_webhook_events")
}

// ─────────────────────────────────────────────
// Outbox (transactional outbox pattern)
// ─────────────────────────────────────────────

model OutboxEvent {
  id          String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  bookingId   String          @db.Uuid
  eventType   String
  payload     Json
  status      OutboxStatus    @default(PENDING)
  attempts    Int             @default(0)
  lockedAt    DateTime?
  processedAt DateTime?
  failedAt    DateTime?
  errorMsg    String?
  createdAt   DateTime        @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  // Worker polls oldest PENDING first: WHERE status=? ORDER BY createdAt.
  @@index([status, createdAt])
  // Reaper requeues stale claims: WHERE status='PROCESSING' AND lockedAt < cutoff.
  @@index([status, lockedAt])
  @@map("outbox_events")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

// ─────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────

model Notification {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @db.Uuid
  bookingId String?  @db.Uuid
  // Idempotency key (e.g. "<bookingId>:<eventType>") — makes outbox re-delivery
  // a no-op instead of creating a duplicate notification row.
  dedupeKey String?  @unique
  titleAr   String
  bodyAr    String
  isRead    Boolean  @default(false)
  sentAt    DateTime?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id])

  // Unread-inbox query: WHERE userId AND isRead.
  @@index([userId, isRead])
  @@index([bookingId])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// Reviews
// ─────────────────────────────────────────────

model Review {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  bookingId   String   @db.Uuid
  reviewerId  String   @db.Uuid
  revieweeId  String   @db.Uuid
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  booking  Booking @relation(fields: [bookingId], references: [id])
  reviewer User    @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee User    @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  @@unique([bookingId, reviewerId])
  @@map("reviews")
}

// ─────────────────────────────────────────────
// Guarantee Tickets
// ─────────────────────────────────────────────

model GuaranteeTicket {
  id          String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  bookingId   String          @unique @db.Uuid
  status      GuaranteeStatus @default(OPEN)
  description String?
  expiresAt   DateTime
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("guarantee_tickets")
}

enum GuaranteeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

// ─────────────────────────────────────────────
// Support
// ─────────────────────────────────────────────

model SupportTicket {
  id        String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String        @db.Uuid
  subject   String
  status    SupportStatus @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user     User             @relation(fields: [userId], references: [id])
  messages SupportMessage[]

  @@index([userId])
  @@map("support_tickets")
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model SupportMessage {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ticketId  String   @db.Uuid
  senderRole String
  body      String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@map("support_messages")
}
