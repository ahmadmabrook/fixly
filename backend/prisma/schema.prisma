generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ─────────────────────────────────────────────
// Users & Auth
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone        String   @unique
  role         UserRole @default(CUSTOMER)
  name         String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  // Short, unique, shareable invite code (§ referrals). Lazily generated on
  // first access via GET /referrals/me — null until then.
  referralCode String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens     RefreshToken[]
  deviceTokens      DeviceToken[]
  technicianProfile TechnicianProfile?
  customerBookings  Booking[]            @relation("CustomerBookings")
  notifications     Notification[]
  reviewsGiven      Review[]             @relation("ReviewsGiven")
  reviewsReceived   Review[]             @relation("ReviewsReceived")
  supportTickets    SupportTicket[]
  addresses         Address[]
  paymentMethods    PaymentMethod[]
  promoRedemptions  PromoRedemption[]
  subscriptions     Subscription[]
  serviceCredits    ServiceCredit[]
  quotes            BookingQuote[]       @relation("CustomerQuotes")
  conductReports    ConductReport[]      @relation("ConductReporter")
  // Referrals this user made (as the referrer) / the single redemption row
  // recording who referred this user in (as the referred new signup).
  referralsGiven    ReferralRedemption[] @relation("ReferralsGiven")
  referredBy        ReferralRedemption?  @relation("ReferralsReceived")

  // Admin customer list filters by role.
  @@index([role])
  // Admin lists order by createdAt desc.
  @@index([createdAt])
  @@map("users")
}

enum UserRole {
  CUSTOMER
  TECHNICIAN
  ADMIN
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  // SHA-256 of the opaque token; the raw value is returned to the client only.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model DeviceToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model AdminUser {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  passwordHash String
  name         String
  // RBAC role. Default is LEAST-privilege (SUPPORT) so a row inserted without an
  // explicit role can never silently become super-admin (fail-closed). The
  // bootstrap admin sets SUPER_ADMIN explicitly in the seed.
  role         AdminRole @default(SUPPORT)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs     AdminAuditLog[]
  refreshTokens AdminRefreshToken[]
  broadcasts    Broadcast[]

  @@map("admin_users")
}

enum AdminRole {
  SUPER_ADMIN
  OPS
  FINANCE
  SUPPORT
}

model AdminRefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId   String    @db.Uuid
  // SHA-256 of the opaque token; the raw value goes out only via httpOnly cookie.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_refresh_tokens")
}

/// Immutable trail of privileged admin actions (who did what, when, from where).
model AdminAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String   @db.Uuid
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor AdminUser @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

// ─────────────────────────────────────────────
// Services Catalog
// ─────────────────────────────────────────────

model Service {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nameAr        String
  nameEn        String
  category      String
  priceJod      Decimal  @db.Decimal(10, 3)
  // Flat callout/dispatch fee charged to the customer on a technician-initiated
  // no-show (§ NO_SHOW booking status). Matches the client-side CALLOUT constant.
  calloutFeeJod Decimal  @default(5.000) @db.Decimal(10, 3)
  durationMin   Int
  // Customer-facing SOP scope shown on the service-detail screen: what the
  // fixed price includes vs. explicitly excludes (Arabic bullet strings).
  sopIncludes   String[] @default([])
  sopExcludes   String[] @default([])
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings    Booking[]
  technicians TechnicianProfile[] @relation("TechnicianServices")
  quotes      BookingQuote[]

  // Public catalogue query: WHERE isActive ORDER BY category.
  @@index([isActive, category])
  @@map("services")
}

// ─────────────────────────────────────────────
// Technician Profile
// ─────────────────────────────────────────────

model TechnicianProfile {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String           @unique @db.Uuid
  bio                   String?
  // Onboarding lifecycle. isVerified is kept (== status APPROVED) for back-compat
  // with existing queries/tests; new code should read `status`.
  status                TechnicianStatus @default(PENDING)
  rejectionReason       String?
  approvedAt            DateTime?
  isAvailable           Boolean          @default(false)
  isVerified            Boolean          @default(false)
  // Onboarding documents (uploaded to object storage; URLs only here).
  idDocUrl              String?
  certificateUrl        String?
  selfieUrl             String?
  vehicle               String?
  hourlyRateJod         Decimal?         @db.Decimal(10, 3)
  // AES-256-GCM ciphertext (iv + authTag + ciphertext, see shared/crypto.ts) of the
  // technician's national ID. Write-only from the API's perspective — no endpoint
  // ever decrypts and returns this to a client (KYC data never round-trips).
  nationalIdEnc         Bytes?
  currentLat            Float?
  currentLng            Float?
  locationUpdatedAt     DateTime?
  // Earnings cash-out cooldown (spec: withdraw at most once / 24h).
  lastWithdrawalAt      DateTime?
  rating                Decimal          @default(0) @db.Decimal(3, 2)
  totalReviews          Int              @default(0)
  // v1.5 trust & vetting (§0.2 #1). trustTier drives dispatch priority + bounds
  // guarantee liability; recomputed nightly from rating/volume/upheld reports.
  trustTier             TrustTier        @default(PROBATION)
  bgCheckStatus         BgCheckStatus    @default(PENDING)
  skillsTestPassedAt    DateTime?
  isInsured             Boolean          @default(false)
  introVideoUrl         String?
  jobsCompleted         Int              @default(0)
  offPlatformFlags      Int              @default(0)
  // Consecutive dispatch-offer rejections (resets to 0 on any accept). Surfaced
  // to the technician app so it can warn at 3+ in a row (§ technician app).
  consecutiveRejections Int              @default(0)
  // Onboarding consent (ToS/SOP agreement) timestamp; null = not yet accepted.
  agreementAcceptedAt   DateTime?
  // Saved payout bank details (profile-level, independent of any single withdrawal
  // request). PATCH /technician/bank-account persists here; requestWithdrawal falls
  // back to these when the request body omits iban/bankName.
  bankIban              String?
  bankName              String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  user              User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  techBookings      Booking[]                    @relation("TechnicianBookings")
  payouts           Payout[]
  withdrawals       WithdrawalRequest[]
  services          Service[]                    @relation("TechnicianServices")
  dispatchOffers    DispatchOffer[]
  conductReports    ConductReport[]
  notificationPrefs TechnicianNotificationPrefs?

  // getStats counts verified technicians; admin list orders by createdAt.
  @@index([isVerified])
  @@index([status])
  @@index([createdAt])
  // Dispatch/quality queries filter by tier (e.g. exclude PROBATION from priority).
  @@index([trustTier])
  @@map("technician_profiles")
}

/// Technician-portal notification toggles (Figma TechNotifications screen).
/// One row per technician, created lazily on first read/write.
model TechnicianNotificationPrefs {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  technicianId    String   @unique @db.Uuid
  newJobRequests  Boolean  @default(true)
  reminders       Boolean  @default(true)
  earningsUpdates Boolean  @default(true)
  promotions      Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  technician TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@map("technician_notification_prefs")
}

enum TechnicianStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// ─────────────────────────────────────────────
// Bookings
// ─────────────────────────────────────────────

model Booking {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId          String        @db.Uuid
  technicianId        String?       @db.Uuid
  serviceId           String        @db.Uuid
  status              BookingStatus @default(PENDING)
  addressLine         String
  addressLat          Float
  addressLng          Float
  scheduledAt         DateTime?
  rescheduledAt       DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  // Pricing: totalJod is the amount charged (service price − discount). discountJod
  // records any promo applied so receipts/reports can show the breakdown.
  discountJod         Decimal       @default(0) @db.Decimal(10, 3)
  promoCodeId         String?       @db.Uuid
  totalJod            Decimal       @db.Decimal(10, 3)
  version             Int           @default(0)
  // Dispatch state: round counter, current radius, and when the round expires.
  dispatchRound       Int           @default(0)
  dispatchRadiusKm    Int?
  dispatchExpiresAt   DateTime?
  // v1.5 SLA + subscriber priority (§0.3). isPriority = subscriber fast-lane;
  // slaArriveBy = arrival promise; arrivedAt set by /arrive; lateCompJod = auto credit.
  isPriority          Boolean       @default(false)
  slaArriveBy         DateTime?
  arrivedAt           DateTime?
  lateCompJod         Decimal       @default(0) @db.Decimal(10, 3)
  // Server-enforced pre-start/pre-close SOP checklist (technician portal). Gating
  // logic lives in BookingService: ARRIVED→IN_PROGRESS requires preStartChecklistAt,
  // complete() requires preCloseChecklistAt.
  preStartChecklistAt DateTime?
  preStartPhotoUrls   String[]      @default([])
  preCloseChecklistAt DateTime?
  preClosePhotoUrls   String[]      @default([])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  customer             User                   @relation("CustomerBookings", fields: [customerId], references: [id])
  technician           TechnicianProfile?     @relation("TechnicianBookings", fields: [technicianId], references: [id])
  service              Service                @relation(fields: [serviceId], references: [id])
  promoCode            PromoCode?             @relation(fields: [promoCodeId], references: [id])
  payment              Payment?
  outboxEvents         OutboxEvent[]
  reviews              Review[]
  notifications        Notification[]
  additionalWork       AdditionalWorkItem[]
  promoRedemption      PromoRedemption?
  offers               DispatchOffer[]
  serviceCredits       ServiceCredit[]
  quote                BookingQuote?
  statusHistory        BookingStatusHistory[]
  // The guarantee ticket opened against this (original) booking.
  guarantee            GuaranteeTicket?       @relation("GuaranteeTicketBooking")
  // The free re-visit booking created when a guarantee ticket was approved
  // with a scheduled visit — set on the NEW booking, pointing back via
  // GuaranteeTicket.followupBookingId.
  guaranteeFollowupFor GuaranteeTicket?       @relation("GuaranteeFollowupBooking")

  @@index([customerId])
  @@index([status])
  // Technician dashboard: "my active jobs" filters by technician + status.
  @@index([technicianId, status])
  // Guarantee-eligible lookup: WHERE customerId AND status AND completedAt >= cutoff.
  @@index([customerId, status, completedAt])
  // "My bookings" lists (customer + technician) sort by createdAt desc.
  @@index([customerId, createdAt])
  @@index([technicianId, createdAt])
  // Dispatch sweep: PENDING bookings with an expired round.
  @@index([status, dispatchExpiresAt])
  // AdminOpsService.getActivityFeed scans recently-updated bookings (48h window).
  @@index([updatedAt])
  @@map("bookings")
}

enum BookingStatus {
  // Hosted-checkout (real PSP) only: booking exists but the customer has not yet
  // authorized payment, so it is NOT visible to technicians. Promotes to PENDING
  // on successful authorization, or is auto-cancelled by the reconciler after the
  // checkout TTL. The instant (mock) provider skips this and starts at PENDING.
  AWAITING_PAYMENT
  PENDING
  CONFIRMED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
  // Technician-initiated: customer was not present/reachable at the address after
  // arrival. Charges the service's calloutFeeJod to the customer. Only reachable
  // from ARRIVED.
  NO_SHOW
}

/// Append-only audit trail of every booking status transition (§ booking_status_history).
/// Written alongside each status write in BookingService (create/accept/advanceStatus/
/// complete/cancel/noShow) — never updated or deleted.
model BookingStatusHistory {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId  String         @db.Uuid
  // Null on the very first row (booking creation has no prior status).
  fromStatus BookingStatus?
  toStatus   BookingStatus
  changedAt  DateTime       @default(now())
  // The acting user (customer/technician) when known; null for system-driven
  // transitions (e.g. the abandonment reconciler's silent cancellation).
  changedBy  String?        @db.Uuid

  booking Booking @relation(fields: [bookingId], references: [id])

  // Admin/audit timeline for a booking, oldest first.
  @@index([bookingId, changedAt])
  @@map("booking_status_history")
}

// ─────────────────────────────────────────────
// Dispatch Offers (broadcast-and-accept)
// ─────────────────────────────────────────────

model DispatchOffer {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId    String              @db.Uuid
  technicianId String              @db.Uuid
  round        Int
  radiusKm     Int
  status       DispatchOfferStatus @default(OFFERED)
  offeredAt    DateTime            @default(now())
  respondedAt  DateTime?

  booking    Booking           @relation(fields: [bookingId], references: [id])
  technician TechnicianProfile @relation(fields: [technicianId], references: [id])

  @@unique([bookingId, technicianId])
  @@index([bookingId, status])
  @@index([status])
  @@map("dispatch_offers")
}

enum DispatchOfferStatus {
  OFFERED
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
}

// ─────────────────────────────────────────────
// Payments & Ledger
// ─────────────────────────────────────────────

model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId         String        @unique @db.Uuid
  status            PaymentStatus @default(PENDING)
  provider          String
  providerRef       String?
  // Hosted-checkout session id (PSP), set when the session is prepared and used to
  // correlate the async authorization result/webhook back to this row. Unique so a
  // booking has at most one live checkout session.
  checkoutId        String?       @unique
  // Payment method used. v1 = card only; applepay/googlepay land later.
  method            String?       @default("card")
  // Tokenised card metadata only — NEVER a PAN. Populated from the checkout result.
  cardBrand         String?
  cardLast4         String?
  currency          String        @default("JOD")
  // Authorized (held) amount. Capture/refund amounts may be ≤ this (partial).
  amountJod         Decimal       @db.Decimal(10, 3)
  capturedAmountJod Decimal?      @db.Decimal(10, 3)
  // Cumulative amount refunded — supports multiple partial refunds.
  refundedAmountJod Decimal       @default(0) @db.Decimal(10, 3)
  // Platform commission withheld at capture (the rest accrues to the technician).
  feeJod            Decimal?      @db.Decimal(10, 3)
  preAuthorizedAt   DateTime?
  capturedAt        DateTime?
  refundedAt        DateTime?
  disputedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  booking       Booking       @relation(fields: [bookingId], references: [id])
  ledgerEntries LedgerEntry[]
  payout        Payout?
  disputes      Dispute[]

  // Financial report groups captured payments by capturedAt within a date range.
  @@index([capturedAt])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PRE_AUTHORIZED
  CAPTURED
  PARTIALLY_REFUNDED
  REFUNDED
  DISPUTED
  CHARGEBACK
  FAILED
}

model LedgerEntry {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Exactly one of paymentId / payoutId is set, depending on the entry type.
  paymentId   String?          @db.Uuid
  payoutId    String?          @db.Uuid
  type        LedgerType
  // Double-entry direction so SUM over a payment nets correctly
  // (CREDIT = money in to platform, DEBIT = money out). Nullable only for
  // pre-existing rows written before this column existed.
  direction   LedgerDirection?
  currency    String           @default("JOD")
  amountJod   Decimal          @db.Decimal(10, 3)
  description String?
  createdAt   DateTime         @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id])
  payout  Payout?  @relation(fields: [payoutId], references: [id])

  @@index([paymentId])
  @@index([payoutId])
  @@map("ledger_entries")
}

enum LedgerType {
  CHARGE
  CAPTURE
  REFUND
  PAYOUT
  FEE
  DISPUTE
  CHARGEBACK
  ADJUSTMENT
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

model Payout {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  technicianId String       @db.Uuid
  // Source payment this payout was accrued from. Unique → at most one payout
  // per captured payment, making accrual idempotent.
  paymentId    String?      @unique @db.Uuid
  currency     String       @default("JOD")
  amountJod    Decimal      @db.Decimal(10, 3)
  status       PayoutStatus @default(PENDING)
  processedAt  DateTime?
  createdAt    DateTime     @default(now())

  technician    TechnicianProfile @relation(fields: [technicianId], references: [id])
  payment       Payment?          @relation(fields: [paymentId], references: [id])
  ledgerEntries LedgerEntry[]

  @@index([technicianId])
  // Technician earnings: per-tech sums filtered by createdAt (today/month buckets).
  @@index([technicianId, createdAt])
  // getStats counts PENDING; admin list filters status + orders by createdAt.
  @@index([status, createdAt])
  @@map("payouts")
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// A PSP-reported dispute / chargeback against a captured payment.
model Dispute {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId   String        @db.Uuid
  providerRef String?
  reason      String?
  amountJod   Decimal       @db.Decimal(10, 3)
  status      DisputeStatus @default(OPEN)
  openedAt    DateTime      @default(now())
  resolvedAt  DateTime?

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("disputes")
}

enum DisputeStatus {
  OPEN
  WON
  LOST
}

/// Idempotent store of inbound PSP webhook events (dedupe at-least-once delivery).
model PspWebhookEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider   String
  eventId    String
  eventType  String
  payload    Json
  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@map("psp_webhook_events")
}

// ─────────────────────────────────────────────
// Outbox (transactional outbox pattern)
// ─────────────────────────────────────────────

model OutboxEvent {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId   String       @db.Uuid
  eventType   String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lockedAt    DateTime?
  processedAt DateTime?
  failedAt    DateTime?
  errorMsg    String?
  createdAt   DateTime     @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  // Worker polls oldest PENDING first: WHERE status=? ORDER BY createdAt.
  @@index([status, createdAt])
  // Reaper requeues stale claims: WHERE status='PROCESSING' AND lockedAt < cutoff.
  @@index([status, lockedAt])
  @@map("outbox_events")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

// ─────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  bookingId String?   @db.Uuid
  // Idempotency key (e.g. "<bookingId>:<eventType>") — makes outbox re-delivery
  // a no-op instead of creating a duplicate notification row.
  dedupeKey String?   @unique
  titleAr   String
  bodyAr    String
  isRead    Boolean   @default(false)
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id])

  // Unread-inbox query: WHERE userId AND isRead.
  @@index([userId, isRead])
  @@index([bookingId])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// Reviews
// ─────────────────────────────────────────────

model Review {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId  String   @db.Uuid
  reviewerId String   @db.Uuid
  revieweeId String   @db.Uuid
  rating     Int
  comment    String?
  // Optional before/after photos (object-storage URLs).
  photos     String[] @default([])
  createdAt  DateTime @default(now())

  booking  Booking @relation(fields: [bookingId], references: [id])
  reviewer User    @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee User    @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  @@unique([bookingId, reviewerId])
  // Technician reviews list + rating aggregate recompute filter by revieweeId.
  @@index([revieweeId, createdAt])
  // Public landing "recent reviews" sorts the whole table by createdAt.
  @@index([createdAt])
  @@map("reviews")
}

// ─────────────────────────────────────────────
// Guarantee Tickets
// ─────────────────────────────────────────────

model GuaranteeTicket {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId         String          @unique @db.Uuid
  status            GuaranteeStatus @default(OPEN)
  description       String?
  // Customer-uploaded evidence (photo/video URLs in object storage).
  mediaUrls         String[]        @default([])
  // Admin review outcome + optional scheduled free re-visit.
  adminNote         String?
  scheduledVisitAt  DateTime?
  // The free re-visit booking created on approval with a scheduled visit
  // (zero-cost, same customer/technician/service). Null until then.
  followupBookingId String?         @unique @db.Uuid
  expiresAt         DateTime
  resolvedAt        DateTime?
  createdAt         DateTime        @default(now())

  booking         Booking  @relation("GuaranteeTicketBooking", fields: [bookingId], references: [id])
  followupBooking Booking? @relation("GuaranteeFollowupBooking", fields: [followupBookingId], references: [id])

  // Admin SLA queue: WHERE status ORDER BY createdAt asc.
  @@index([status, createdAt])
  @@map("guarantee_tickets")
}

enum GuaranteeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

// ─────────────────────────────────────────────
// Support
// ─────────────────────────────────────────────

model SupportTicket {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String        @db.Uuid
  subject   String
  status    SupportStatus @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user     User             @relation(fields: [userId], references: [id])
  messages SupportMessage[]

  // Customer list: WHERE userId ORDER BY updatedAt desc.
  @@index([userId, updatedAt])
  // Admin queue: WHERE status ORDER BY updatedAt desc.
  @@index([status, updatedAt])
  @@map("support_tickets")
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model SupportMessage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId   String   @db.Uuid
  senderRole String
  body       String
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@map("support_messages")
}

// ─────────────────────────────────────────────
// Customer addresses (saved locations)
// ─────────────────────────────────────────────

model Address {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  label     String
  line      String
  lat       Float
  lng       Float
  building  String?
  apartment String?
  notes     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────────────────────────
// Saved payment methods (card data is mocked by the PSP; only a token + display
// metadata is stored here — never a PAN).
// ─────────────────────────────────────────────

model PaymentMethod {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @db.Uuid
  brand       String
  last4       String
  expMonth    Int
  expYear     Int
  providerRef String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payment_methods")
}

// ─────────────────────────────────────────────
// Promo / discount codes
// ─────────────────────────────────────────────

model PromoCode {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String    @unique
  type           PromoType
  // PERCENT → 0–100; FIXED → JOD amount off.
  value          Decimal   @db.Decimal(10, 3)
  minOrderJod    Decimal?  @db.Decimal(10, 3)
  // Total redemptions allowed across all users (null = unlimited).
  maxRedemptions Int?
  // Redemptions allowed per individual user.
  perUserLimit   Int       @default(1)
  timesRedeemed  Int       @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  bookings    Booking[]
  redemptions PromoRedemption[]

  @@index([isActive])
  @@map("promo_codes")
}

enum PromoType {
  PERCENT
  FIXED
}

model PromoRedemption {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promoCodeId String   @db.Uuid
  userId      String   @db.Uuid
  // One redemption per booking (a booking can carry at most one promo).
  bookingId   String   @unique @db.Uuid
  amountJod   Decimal  @db.Decimal(10, 3)
  createdAt   DateTime @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  booking   Booking   @relation(fields: [bookingId], references: [id])

  // Per-user redemption-cap check: COUNT WHERE promoCodeId AND userId.
  @@index([promoCodeId, userId])
  @@index([userId])
  @@map("promo_redemptions")
}

// ─────────────────────────────────────────────
// Technician-initiated balance withdrawals
// ─────────────────────────────────────────────

model WithdrawalRequest {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  technicianId String           @db.Uuid
  amountJod    Decimal          @db.Decimal(10, 3)
  status       WithdrawalStatus @default(REQUESTED)
  iban         String?
  bankName     String?
  processedAt  DateTime?
  createdAt    DateTime         @default(now())

  technician TechnicianProfile @relation(fields: [technicianId], references: [id])

  @@index([technicianId])
  @@index([status, createdAt])
  @@map("withdrawal_requests")
}

enum WithdrawalStatus {
  REQUESTED
  PROCESSING
  PAID
  REJECTED
}

// ─────────────────────────────────────────────
// Admin broadcast notifications
// ─────────────────────────────────────────────

model Broadcast {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titleAr        String
  bodyAr         String
  segment        BroadcastSegment
  recipientCount Int              @default(0)
  sentById       String           @db.Uuid
  createdAt      DateTime         @default(now())

  sentBy AdminUser @relation(fields: [sentById], references: [id])

  @@index([createdAt])
  @@map("broadcasts")
}

enum BroadcastSegment {
  ALL
  CUSTOMERS
  TECHNICIANS
}

// ─────────────────────────────────────────────
// Additional-work items (technician proposes extra work mid-job; customer approves)
// ─────────────────────────────────────────────

model AdditionalWorkItem {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId   String               @db.Uuid
  description String
  amountJod   Decimal              @db.Decimal(10, 3)
  status      AdditionalWorkStatus @default(PROPOSED)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@map("additional_work_items")
}

enum AdditionalWorkStatus {
  PROPOSED
  APPROVED
  DECLINED
}

// ─────────────────────────────────────────────
// v1.5 — Technician trust tiers & vetting (§0.2 #1)
// ─────────────────────────────────────────────

enum TrustTier {
  PROBATION
  VERIFIED
  PRO
  ELITE
}

enum BgCheckStatus {
  PENDING
  PASSED
  FAILED
}

// ─────────────────────────────────────────────
// v1.5 — Protection subscription (recurring plan; benefits applied at booking)
// ─────────────────────────────────────────────

model Subscription {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId          String             @db.Uuid
  planSlug            String             @default("protect")
  status              SubscriptionStatus @default(ACTIVE)
  priceJod            Decimal            @default(5.000) @db.Decimal(10, 3)
  // Percent off each booking (0–100), matching PromoType.PERCENT semantics.
  discountPercent     Int                @default(15)
  guaranteeDays       Int                @default(90)
  priorityDispatch    Boolean            @default(true)
  inspectionEveryDays Int                @default(90)
  nextInspectionAt    DateTime?
  currentPeriodEnd    DateTime
  // PSP card-on-file token for the recurring charge (never a PAN).
  paymentToken        String?
  providerRef         String?
  cancelledAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  customer User                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  charges  SubscriptionCharge[]

  // At most one ACTIVE subscription per customer is enforced by a partial unique
  // index added in the migration (Prisma @@unique can't carry a WHERE clause).
  @@index([customerId])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model SubscriptionCharge {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String        @db.Uuid
  amountJod      Decimal       @db.Decimal(10, 3)
  status         PaymentStatus @default(PENDING)
  providerRef    String?
  periodStart    DateTime
  periodEnd      DateTime
  chargedAt      DateTime?
  createdAt      DateTime      @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@map("subscription_charges")
}

// ─────────────────────────────────────────────
// v1.5 — Video pre-check quotes (customer uploads a problem video; a firm price is
// set and, on accept, becomes the booking price — preserves the "no surprises" promise)
// ─────────────────────────────────────────────

model BookingQuote {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String      @db.Uuid
  serviceId   String      @db.Uuid
  status      QuoteStatus @default(PENDING)
  videoUrl    String
  description String?
  // FIRM price set on review; becomes the booking's totalJod on accept.
  quotedJod   Decimal?    @db.Decimal(10, 3)
  quotedById  String?     @db.Uuid
  addressLine String?
  addressLat  Float?
  addressLng  Float?
  bookingId   String?     @unique @db.Uuid
  expiresAt   DateTime
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customer User     @relation("CustomerQuotes", fields: [customerId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id])
  booking  Booking? @relation(fields: [bookingId], references: [id])

  @@index([customerId, createdAt])
  @@index([status])
  @@map("booking_quotes")
}

enum QuoteStatus {
  PENDING
  QUOTED
  ACCEPTED
  DECLINED
  EXPIRED
}

// ─────────────────────────────────────────────
// v1.5 — Customer service-credit wallet (late compensation / referral / goodwill).
// Balance = SUM(amountJod). Grants are exactly-once via refKey; redemption is a
// negative row capped at the amount due (never makes a charge negative).
// ─────────────────────────────────────────────

model ServiceCredit {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String       @db.Uuid
  // Signed: positive = granted, negative = redeemed.
  amountJod  Decimal      @db.Decimal(10, 3)
  reason     CreditReason
  bookingId  String?      @db.Uuid
  // Exactly-once guard for automatic grants (e.g. 'latecomp:{bookingId}').
  refKey     String?      @unique
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())

  customer User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id])

  @@index([customerId, createdAt])
  @@map("service_credits")
}

enum CreditReason {
  LATE_COMPENSATION
  REFERRAL
  GOODWILL
  PROMO
  ADJUSTMENT
  REDEMPTION
}

// ─────────────────────────────────────────────
// v1.5 — Conduct reports (anti-disintermediation + quality, §0.2 #2). An UPHELD
// report increments technician_profiles.offPlatformFlags and can demote trust tier.
// ─────────────────────────────────────────────

model ConductReport {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId    String        @db.Uuid
  subjectTechId String?       @db.Uuid
  bookingId     String?       @db.Uuid
  kind          ConductKind
  details       String?
  status        ConductStatus @default(OPEN)
  resolvedById  String?       @db.Uuid
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  reporter    User               @relation("ConductReporter", fields: [reporterId], references: [id])
  subjectTech TechnicianProfile? @relation(fields: [subjectTechId], references: [id])

  @@index([status, createdAt])
  @@index([subjectTechId])
  @@map("conduct_reports")
}

enum ConductKind {
  OFF_PLATFORM_SOLICIT
  NO_SHOW
  QUALITY
  SAFETY
  OTHER
}

enum ConductStatus {
  OPEN
  REVIEWING
  UPHELD
  DISMISSED
}

// ─────────────────────────────────────────────
// Referrals — invite code capture at signup + one-time credit grant on the
// referred user's first completed booking. Structurally mirrors PromoCode/
// PromoRedemption: User.referralCode is the "code" side, this table is the
// "redemption" side (one row per referred signup, exactly once).
// ─────────────────────────────────────────────

model ReferralRedemption {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrerId      String    @db.Uuid
  // A user can be referred at most once (captured at their own signup).
  referredUserId  String    @unique @db.Uuid
  // Set once the referrer's credit has been granted (on the referred user's
  // first COMPLETED booking) — guards against double-granting.
  creditGrantedAt DateTime?
  createdAt       DateTime  @default(now())

  referrer     User @relation("ReferralsGiven", fields: [referrerId], references: [id])
  referredUser User @relation("ReferralsReceived", fields: [referredUserId], references: [id])

  // Referrer's "my referrals" list + stats.
  @@index([referrerId])
  @@map("referral_redemptions")
}
