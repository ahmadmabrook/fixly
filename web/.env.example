# Mapbox public token (pk.*) — URL-restrict it in the Mapbox dashboard.
VITE_MAPBOX_TOKEN=pk.your_public_token_here

# Fly.io backend origin for the Socket.IO real-time connection. Cloudflare Pages
# proxies /api/* to the backend but has no equivalent for /socket.io/*, so the
# socket must connect directly to this origin rather than same-origin. Leave
# unset in local dev — vite.config.ts's dev-server proxy already forwards
# /socket.io to the backend same-origin.
VITE_SOCKET_URL=https://fixly.fly.dev
